#!/bin/sh
# Git for Windows supplies sh; Python is the only scanner dependency.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
for python in python3 python; do
    if command -v "$python" >/dev/null 2>&1 && "$python" -c 'import sys; sys.exit(sys.version_info.major != 3)' >/dev/null 2>&1; then
        exec "$python" "$script_dir/scanner.py" "$(basename -- "$0")" "$@"
    fi
done
if command -v py >/dev/null 2>&1 && py -3 -c 'import sys' >/dev/null 2>&1; then
    exec py -3 "$script_dir/scanner.py" "$(basename -- "$0")" "$@"
fi
echo 'Hook blocked: Python 3 is required. Install Python 3 and retry.' >&2
exit 1
