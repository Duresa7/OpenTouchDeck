# CI's QEMU image of the radio build: `idf.py -B <dir> -DTD_RADIO_BUILD=1 -DTD_QEMU_TEST=1 build` layers this file over
# radio/radio.defaults. QEMU has no panel, touch controller, USB-Serial/JTAG or Wi-Fi, so the image runs the link and
# net-v2 over QEMU's emulated Ethernet, logs to UART0, and opens a pairing window at boot. firmware/tools/radio_guard.py
# fails any build that has these options, so they never reach a Device.
CONFIG_TD_QEMU_TEST=y
CONFIG_ETH_USE_OPENETH=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# QEMU runs far slower than the chip, so the watchdogs would fire on emulation, not on a hang.
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_INT_WDT=n
# QEMU crashed (SIGSEGV) as the app started with the board's octal PSRAM, so the image runs from internal RAM: the
# net-v2 service falls back to it when there is no PSRAM. It also keeps to what QEMU models: 40 MHz flash, which needs
# no MSPI timing tuning, no flash high-performance mode, no memory protection or brownout detector, and ESP-IDF's
# default cache layout.
CONFIG_SPIRAM=n
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_SPI_FLASH_HPM_DIS=y
CONFIG_ESP_SYSTEM_MEMPROT=n
CONFIG_ESP_BROWNOUT_DET=n
CONFIG_ESP32S3_INSTRUCTION_CACHE_16KB=y
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_32B=y
