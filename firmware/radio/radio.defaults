# The radio build's options. `idf.py -DTD_RADIO_BUILD=1` layers this file over sdkconfig.defaults (see
# firmware/CMakeLists.txt), into a build directory and an sdkconfig of its own. Never merge these into sdkconfig or
# sdkconfig.defaults: the normal build stays radio-free, and its guards check that. firmware/tools/radio_guard.py
# checks the radio build against the options below.

# Internal RAM is what the radios cost. The RGB panel's bounce buffers, the render tasks and the perf task need it,
# and the first Wi-Fi attempt left about 1 KB free with the station up. Wi-Fi and lwIP buffers come from PSRAM where
# ESP-IDF allows it. The static RX buffers and the driver's queues must stay internal, so they are sized for the app
# link's few KB a second, not for throughput. The Wi-Fi driver keeps no network in NVS.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=2
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
# IRAM and DRAM share the same internal SRAM on the ESP32-S3, so code kept in IRAM for speed is heap the panel loses.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
# malloc() puts blocks under 16 KB in internal RAM by default. In the radio build, blocks of 256 bytes and up go to
# PSRAM first, which the Wi-Fi station's share of internal RAM needs. Code runs from PSRAM (XIP), so PSRAM stays
# readable while flash is written.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
# Static .bss in PSRAM where ESP-IDF allows it: the Wi-Fi driver's, lwIP's and wpa_supplicant's (ESP-IDF places them
# there with this option) and the link's frame buffers (EXT_RAM_BSS_ATTR in td_link.c). That frees about 18.6 KB of
# static internal RAM, more than the 4.3 KB that linking the BLE controller and NimBLE costs.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# LVGL's objects, styles and strings go to PSRAM first (display_lv_mem.c). Under malloc's 256-byte rule nearly all of
# them stayed internal, about 15 KB by the first frame, and the Wi-Fi station's start needs that RAM at boot (#313).
CONFIG_LV_USE_CUSTOM_MALLOC=y

# Task stacks sized from the board run with the station up. `perf mem` at these sizes, as option -> stack the task
# got -> minimum free bytes (high-water mark): tcpip 2048 -> 2560 -> 1400; sys_evt 1792 -> 2304 -> 1172; esp_timer
# 3072 -> 3584 -> 2216, with the heartbeat on it; Tmr Svc 1536 -> 1536 -> 940. ESP-IDF gives the first three 512
# bytes more than their option. Every one keeps at least 940 bytes free. A later ticket that runs a TCP service or
# logs more from these tasks measures again.
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=2048
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=1792
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3072
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=1536

# The Bluetooth keyboard (td_ble). NimBLE starts only when the stored setting is on, which it is not until the person
# turns it on, so a fresh Device never advertises. The controller runs from flash and NimBLE takes its memory from
# PSRAM, allocated when it starts and freed when it stops. No observer or central role is compiled in, so the Device
# cannot scan or start a connection.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_STATIC_TO_DYNAMIC=y
# One host at a time, up to four bonds that survive a reboot. Each bond keeps up to four CCCDs: the keyboard, consumer
# and boot keyboard inputs and Service Changed.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MAX_CCCDS=16
# LE Secure Connections only: no legacy pairing, whose keys a sniffer can recover. td_ble adds MITM protection: the
# host types the passkey the Device shows.
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
# Privacy: NimBLE gives the controller each bonded host's IRK, and the controller resolves a host's resolvable private
# address before the accept list, so phones and computers that reconnect from private addresses get in.
CONFIG_BT_NIMBLE_HS_PVCY=y
# The Peripheral Preferred Connection Parameters match the one request td_ble sends after encryption: 7.5-50 ms,
# latency 0, a 4 s supervision timeout.
CONFIG_BT_NIMBLE_SVC_GAP_PPCP_MIN_CONN_INTERVAL=6
CONFIG_BT_NIMBLE_SVC_GAP_PPCP_MAX_CONN_INTERVAL=40
CONFIG_BT_NIMBLE_SVC_GAP_PPCP_SLAVE_LATENCY=0
CONFIG_BT_NIMBLE_SVC_GAP_PPCP_SUPERVISION_TMO=400
