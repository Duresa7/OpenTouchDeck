// The Open TouchDeck window: a navigation pane, the current page, and the one-time close notice.
import { Palette } from "std-widgets.slint";
import { Theme, ContrastColors } from "theme.slint";
import { NavItem } from "controls.slint";
import { HomePage, DeviceRow, Tone } from "home.slint";
import { AboutPage, Component } from "about.slint";
import { SetupPage, BoardCard, SetupLater, Wizard } from "setup.slint";
import { SettingsPage, PcSettings, DeviceEntry, DevicePage, PairedApp } from "settings.slint";
import { CloseNotice } from "close-notice.slint";
import { IntegrationsPage, Integrations, IntegrationRow, IntegrationField, IntegrationSecret, IntegrationPage, DeliveryProblem, UsageAccount } from "integrations.slint";
import { TableCell } from "controls.slint";
import { IconPacks } from "icon-packs.slint";
import { Brandfetch } from "brandfetch.slint";

export { Theme, ContrastColors, DeviceRow, Tone, Component, BoardCard, SetupLater, Wizard, PcSettings, DeviceEntry, DevicePage, PairedApp }
export { Integrations, IntegrationRow, IntegrationField, IntegrationSecret, IntegrationPage, DeliveryProblem, UsageAccount, TableCell, IconPacks, Brandfetch }

export enum Page { home, setup, settings, integrations, about }

export component AppWindow inherits Window {
    title: "Open TouchDeck";
    // About 500 effective pixels: the largest minimum Windows recommends, so Snap keeps the halves.
    min-width: 500px;
    min-height: 360px;
    preferred-width: 960px;
    preferred-height: 640px;
    background: Theme.window-background;
    default-font-size: Theme.body;
    default-font-family: Theme.text-font;

    in-out property <Page> page: Page.home;
    in property <[DeviceRow]> devices;
    in property <string> version;
    in property <[Component]> components;
    in-out property <bool> close-notice-open;
    // The app's own light or dark choice; `unknown` follows the system.
    in property <ColorScheme> appearance: ColorScheme.unknown;

    // Setup.
    in property <[BoardCard]> boards;
    in property <[string]> ignored-boards;
    in property <bool> wizard-open;
    in property <Wizard> wizard;
    in property <[SetupLater]> setup-later;
    // How many things wait in Setup, shown beside its name.
    in property <int> setup-count;
    callback install-board(string);
    callback ignore-board(string);
    callback restore-board(string);
    callback cancel-board(string);
    callback wizard-name-edited(string);
    callback wizard-next();
    callback wizard-back();
    callback wizard-close();
    callback wizard-orientation(string);
    callback wizard-update();
    callback wizard-skip();
    callback start-setup(string);

    // Settings.
    in property <PcSettings> pc;
    in property <[DeviceEntry]> settings-devices;
    in-out property <string> settings-device;
    in property <DevicePage> device-page;
    in property <[PairedApp]> paired-apps;
    in property <[string]> after-choices;
    in-out property <bool> confirming-forget-all;
    callback set-start(bool);
    callback set-updates(bool);
    callback set-appearance(string);
    callback open-device(string);
    callback rename-device(string);
    callback choose-orientation(string);
    callback cancel-orientation();
    callback confirm-orientation();
    callback set-photo(bool);
    callback set-after(int);
    callback choose-folder();
    callback forget-app(string);
    callback forget-all();
    callback update-firmware();
    callback restart-device();

    callback open-url(string);
    callback keep-running();
    callback quit();
    // The light or dark scheme changed, so Windows can draw Mica to match.
    callback dark-changed(bool);

    changed appearance => {
        Palette.color-scheme = self.appearance;
    }
    init => {
        Palette.color-scheme = self.appearance;
    }

    property <bool> dark: Theme.dark;
    changed dark => {
        root.dark-changed(self.dark);
    }

    HorizontalLayout {
        Rectangle {
            accessible-role: tab-list;
            accessible-label: "Pages";
            horizontal-stretch: 0;
            VerticalLayout {
                alignment: start;
                padding: 8px;
                padding-top: 16px;
                spacing: 4px;
                min-width: 148px;
                NavItem {
                    text: "Home";
                    selected: root.page == Page.home;
                    activated => {
                        root.page = Page.home;
                    }
                }

                NavItem {
                    text: root.setup-count > 0 ? "Setup (" + root.setup-count + ")" : "Setup";
                    label: "Setup";
                    selected: root.page == Page.setup;
                    activated => {
                        root.page = Page.setup;
                    }
                }

                NavItem {
                    text: "Settings";
                    selected: root.page == Page.settings;
                    activated => {
                        root.page = Page.settings;
                    }
                }

                NavItem {
                    text: "Integrations";
                    selected: root.page == Page.integrations;
                    activated => {
                        root.page = Page.integrations;
                    }
                }

                NavItem {
                    text: "About";
                    selected: root.page == Page.about;
                    activated => {
                        root.page = Page.about;
                    }
                }
            }
        }

        // The content layer, as Windows 11 draws it over Mica.
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.high-contrast ? transparent : Theme.dark ? #3a3a3a4d : #ffffff80;
            border-top-left-radius: 8px;
            border-width: 1px;
            border-color: Theme.high-contrast ? Theme.contrast.window-text : Theme.card-stroke;

            if root.page == Page.home: HomePage {
                devices: root.devices;
            }
            if root.page == Page.setup: SetupPage {
                boards: root.boards;
                ignored: root.ignored-boards;
                wizard-open: root.wizard-open;
                wizard: root.wizard;
                later: root.setup-later;
                install(id) => {
                    root.install-board(id);
                }
                ignore(id) => {
                    root.ignore-board(id);
                }
                restore(id) => {
                    root.restore-board(id);
                }
                cancel-board(id) => {
                    root.cancel-board(id);
                }
                name-edited(text) => {
                    root.wizard-name-edited(text);
                }
                next => {
                    root.wizard-next();
                }
                back => {
                    root.wizard-back();
                }
                close => {
                    root.wizard-close();
                }
                choose-orientation(value) => {
                    root.wizard-orientation(value);
                }
                update => {
                    root.wizard-update();
                }
                skip => {
                    root.wizard-skip();
                }
                start-setup(id) => {
                    root.start-setup(id);
                }
            }
            if root.page == Page.settings: SettingsPage {
                pc: root.pc;
                devices: root.settings-devices;
                device-id: root.settings-device;
                device: root.device-page;
                paired: root.paired-apps;
                after-choices: root.after-choices;
                confirming-forget-all <=> root.confirming-forget-all;
                set-start(on) => {
                    root.set-start(on);
                }
                set-updates(on) => {
                    root.set-updates(on);
                }
                set-appearance(value) => {
                    root.set-appearance(value);
                }
                open-device(id) => {
                    root.confirming-forget-all = false;
                    root.settings-device = id;
                    root.open-device(id);
                }
                close-device => {
                    root.settings-device = "";
                    root.open-device("");
                }
                rename(text) => {
                    root.rename-device(text);
                }
                choose-orientation(value) => {
                    root.choose-orientation(value);
                }
                cancel-orientation => {
                    root.cancel-orientation();
                }
                confirm-orientation => {
                    root.confirm-orientation();
                }
                set-photo(on) => {
                    root.set-photo(on);
                }
                set-after(index) => {
                    root.set-after(index);
                }
                choose-folder => {
                    root.choose-folder();
                }
                forget(app) => {
                    root.forget-app(app);
                }
                forget-all => {
                    root.forget-all();
                }
                update-firmware => {
                    root.update-firmware();
                }
                restart => {
                    root.restart-device();
                }
            }
            if root.page == Page.integrations: IntegrationsPage { }
            if root.page == Page.about: AboutPage {
                version: root.version;
                components: root.components;
                open-url(url) => {
                    root.open-url(url);
                }
            }
        }
    }

    if root.close-notice-open: CloseNotice {
        keep-running => {
            root.keep-running();
        }
        quit => {
            root.quit();
        }
    }
}
