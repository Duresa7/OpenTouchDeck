// The look the platform asks for. Rust fills the inputs: on Windows from UISettings and the
// contrast theme, on Linux from the desktop portal. Slint's Fluent style already follows light
// and dark and the accent colour; everything here builds on its Palette.
import { Palette } from "std-widgets.slint";

// A contrast theme's colours, named as Windows names them.
export struct ContrastColors {
    window: color,
    window-text: color,
    highlight: color,
    highlight-text: color,
    hotlight: color,
    gray-text: color,
    button-face: color,
    button-text: color,
}

export global Theme {
    // The text size setting (Windows: Settings > Accessibility > Text size), 1.0 to 2.25.
    in property <float> text-scale: 1.0;
    // A contrast theme is on, so every colour comes from `contrast`.
    in property <bool> high-contrast: false;
    // The system's contrast colours. Without them (Linux), black and white stand in.
    in property <bool> has-system-contrast: false;
    in property <ContrastColors> system-contrast;
    // Mica shows behind the window, so the window background stays transparent.
    in property <bool> backdrop: false;
    // Segoe UI Variable on Windows. Empty picks the desktop's UI font.
    in property <string> text-font: "";
    in property <string> display-font: "";

    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <ContrastColors> contrast: has-system-contrast ? system-contrast : dark ? {
        window: #000000,
        window-text: #ffffff,
        highlight: #ffff00,
        highlight-text: #000000,
        hotlight: #00ffff,
        gray-text: #c0c0c0,
        button-face: #000000,
        button-text: #ffffff,
    } : {
        window: #ffffff,
        window-text: #000000,
        highlight: #00008b,
        highlight-text: #ffffff,
        hotlight: #00008b,
        gray-text: #595959,
        button-face: #ffffff,
        button-text: #000000,
    };

    // Colours, from the Windows 11 design tokens where the Fluent Palette has no match.
    out property <brush> window-background: high-contrast ? contrast.window : backdrop ? transparent : Palette.background;
    out property <brush> text: high-contrast ? contrast.window-text : Palette.foreground;
    out property <brush> secondary-text: high-contrast ? contrast.window-text : dark ? #ffffffc9 : #00000099;
    out property <brush> accent: high-contrast ? contrast.highlight : Palette.accent-background;
    out property <brush> accent-text: high-contrast ? contrast.highlight-text : Palette.accent-foreground;
    out property <brush> link: high-contrast ? contrast.hotlight : Palette.accent-background;
    out property <brush> card: high-contrast ? contrast.window : dark ? #ffffff0d : #ffffffb3;
    out property <brush> card-stroke: high-contrast ? contrast.window-text : dark ? #0000001a : #0000000f;
    out property <brush> subtle-hover: high-contrast ? transparent : dark ? #ffffff0a : #00000006;
    out property <brush> subtle-selected: high-contrast ? transparent : dark ? #ffffff0f : #0000000a;
    out property <brush> control: high-contrast ? contrast.button-face : dark ? #ffffff0f : #ffffffb3;
    out property <brush> control-hover: high-contrast ? contrast.button-face : dark ? #ffffff15 : #f9f9f980;
    out property <brush> control-text: high-contrast ? contrast.button-text : Palette.foreground;
    out property <brush> control-stroke: high-contrast ? contrast.button-text : dark ? #ffffff17 : #00000024;
    out property <brush> dialog: high-contrast ? contrast.window : dark ? #2b2b2b : #ffffff;
    out property <brush> smoke: high-contrast ? transparent : #0000004d;
    out property <brush> focus: high-contrast ? contrast.window-text : dark ? #ffffff : #000000e6;
    // Device states: success, caution and critical. A contrast theme keeps text colour, so the
    // words, not the colour, carry the state.
    out property <brush> good: high-contrast ? contrast.window-text : dark ? #6ccb5f : #0f7b0f;
    out property <brush> caution: high-contrast ? contrast.window-text : dark ? #fce100 : #9d5d00;
    out property <brush> critical: high-contrast ? contrast.window-text : dark ? #ff99a4 : #c42b1c;

    // The Windows type ramp in effective pixels, scaled by the text size setting.
    out property <length> caption: 12px * text-scale;
    out property <length> body: 14px * text-scale;
    out property <length> body-large: 18px * text-scale;
    out property <length> subtitle: 20px * text-scale;
    out property <length> title: 28px * text-scale;
    out property <int> semibold: 600;
}
